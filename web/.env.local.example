# Copy to .env.local and fill in from your Supabase project's API settings.
#
# Both are public by design: the anon key identifies the project and every
# privilege it carries is enforced server-side. The key that must NEVER appear
# here or anywhere in the browser is `service_role`, which bypasses row-level
# security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
