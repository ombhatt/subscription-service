# --- app ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subscriptions
REDIS_URL=redis://localhost:6379/0
ADMIN_API_KEY=change-me-in-prod

# --- auth ---
# Supabase project URL. Sessions are JWTs signed with the project's
# asymmetric key and verified locally against its JWKS, so no request to
# Supabase sits in the hot path. The anon key is NOT needed here -- it
# belongs in the frontend, where it is public by design.
SUPABASE_URL=https://your-project-ref.supabase.co

# --- stripe ---
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:8000/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Printed by `python -m scripts.seed_stripe`
STRIPE_PRICE_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PLUS_ANNUAL=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx

# --- urls the customer is sent back to ---
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/
PORTAL_RETURN_URL=http://localhost:3000/billing

# --- policy ---
# Days a past_due subscription keeps paid access before dropping to free
DUNNING_GRACE_DAYS=7
# Seconds an entitlement set may be served from cache
ENTITLEMENT_CACHE_TTL=60

# Stripe Tax. Requires a head office/origin address on the Stripe account --
# without one, Stripe rejects every Checkout Session. Safe to disable while
# developing; you owe the tax either way, so turn it on before you launch.
AUTOMATIC_TAX=true
